{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/_expo/static/:path*",
      "destination": "/_expo/static/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
